# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── PostgreSQL Database ───────────────────────────────────────────────────────
# Create the database manually first:
#   psql -U postgres -c "CREATE DATABASE smart_campus;"
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_campus
DB_USER=postgres
DB_PASSWORD=your_actual_local_password

# ─── Authentication ────────────────────────────────────────────────────────────
# Generate a strong random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# ─── LLM / AI Chatbot (optional) ──────────────────────────────────────────────
# Leave blank to use the built-in rule-based fallback.
# Supported: OpenAI, Groq, or any OpenAI-compatible provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ─── CORS (production only) ────────────────────────────────────────────────────
# Set this to your frontend domain when deploying.
# Not required for local development.
ALLOWED_ORIGIN=https://your-domain.com
