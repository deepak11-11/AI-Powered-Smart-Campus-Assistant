# ─────────────────────────────────────────────────────────────────────────────
# ROOT .env.example — for reference only.
#
# Each sub-project has its OWN env file:
#   server/.env          ← copy from server/.env.example  (has DB password, JWT secret)
#   client/.env.local    ← copy from client/.env.example  (safe, browser-visible only)
#
# This root file is just a quick-reference summary.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server (copy to server/.env) ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_campus
DB_USER=postgres
DB_PASSWORD=1105
JWT_SECRET=replace_with_a_long_random_string
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ── Client (copy to client/.env.local) ────────────────────────────────────────
# SAFE — this value is visible in the browser bundle. Never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:4000
